{
  "expo": {
    "name": "CyrusCRM_ext",
    "slug": "CyrusCRM_ext",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cyruscrmext",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sphinxtravel.CyrusCRM_ext"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NotoKufiArabic-Black.ttf",
            "./assets/fonts/NotoKufiArabic-Bold.ttf",
            "./assets/fonts/NotoKufiArabic-ExtraBold.ttf",
            "./assets/fonts/NotoKufiArabic-ExtraLight.ttf",
            "./assets/fonts/NotoKufiArabic-Light.ttf",
            "./assets/fonts/NotoKufiArabic-Medium.ttf",
            "./assets/fonts/NotoKufiArabic-Regular.ttf",
            "./assets/fonts/NotoKufiArabic-SemiBold.ttf",
            "./assets/fonts/NotoKufiArabic-Thin.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
